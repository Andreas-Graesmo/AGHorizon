<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <!-- the app: the same pages as the desktop app, from the server inside the app -->
    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- the player: covers the app while something plays. Laid out like the desktop app's player (public/index.html, #player) -->
    <FrameLayout
        android:id="@+id/playerLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="fit"
            app:show_buffering="when_playing"
            app:surface_type="surface_view"
            app:use_controller="false" />

        <!-- the title: for a moment when something starts, and with the controls -->
        <LinearLayout
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/player_banner_bg"
            android:gravity="top"
            android:orientation="horizontal"
            android:paddingStart="48dp"
            android:paddingTop="24dp"
            android:paddingEnd="48dp"
            android:paddingBottom="44dp"
            android:visibility="gone">

            <!-- the channel's number -->
            <TextView
                android:id="@+id/bannerNum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:minWidth="36dp"
                android:paddingStart="8dp"
                android:paddingTop="1dp"
                android:paddingEnd="8dp"
                android:paddingBottom="1dp"
                android:textColor="#0c0e12"
                android:textSize="17sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/bannerTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:shadowColor="#99000000"
                    android:shadowDy="1"
                    android:shadowRadius="6"
                    android:textColor="#ffffff"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/bannerSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:shadowColor="#99000000"
                    android:shadowDy="1"
                    android:shadowRadius="6"
                    android:textColor="#c9cfdb"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#99000000"
                android:shadowDy="1"
                android:shadowRadius="6"
                android:textColor="#ffffff"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- the controls (PlayerControls), like the desktop player's: the bar with the times at its ends, then a row of
             buttons with play / pause in the middle -->
        <LinearLayout
            android:id="@+id/controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/player_controls_bg"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingTop="64dp"
            android:paddingEnd="40dp"
            android:paddingBottom="20dp"
            android:visibility="gone">

            <!-- a channel: what is on now, and what comes next -->
            <LinearLayout
                android:id="@+id/progRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="6dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/progTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="#ffffff"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/progNext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:ellipsize="end"
                    android:maxWidth="420dp"
                    android:maxLines="1"
                    android:textColor="#aab2c4"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- the time at both ends of the bar: a movie's position and length, or the programme's start and end -->
            <LinearLayout
                android:id="@+id/seekRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/timeLeft"
                    style="@style/PlayerTime" />

                <!-- ◀ ▶ skip while it has the focus -->
                <SeekBar
                    android:id="@+id/seek"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:focusable="true"
                    android:maxHeight="5dp"
                    android:minHeight="5dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:progressDrawable="@drawable/player_seek"
                    android:splitTrack="false"
                    android:thumb="@drawable/player_thumb" />

                <TextView
                    android:id="@+id/timeRight"
                    style="@style/PlayerTime" />
            </LinearLayout>

            <!-- the buttons: sound and subtitles on the left, skip and play / pause in the middle, LIVE on the right -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btnAudio"
                        style="@style/PlayerIcon"
                        android:contentDescription="Audio"
                        android:src="@drawable/ic_p_audio" />

                    <ImageView
                        android:id="@+id/btnSubs"
                        style="@style/PlayerIcon"
                        android:contentDescription="Subtitles"
                        android:src="@drawable/ic_p_cc" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/btnBack"
                        style="@style/PlayerSkip"
                        android:contentDescription="Back 15 seconds">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_p_back" />

                        <TextView style="@style/PlayerSkipText" />
                    </FrameLayout>

                    <ImageView
                        android:id="@+id/btnPlay"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="18dp"
                        android:layout_marginEnd="18dp"
                        android:clickable="true"
                        android:contentDescription="Play / pause"
                        android:elevation="6dp"
                        android:focusable="true"
                        android:padding="19dp"
                        android:src="@drawable/ic_p_pause" />

                    <FrameLayout
                        android:id="@+id/btnFwd"
                        style="@style/PlayerSkip"
                        android:contentDescription="Forward 15 seconds">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_p_fwd" />

                        <TextView style="@style/PlayerSkipText" />
                    </FrameLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/liveBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/player_live_bg"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.05"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:text="●  LIVE"
                    android:textColor="#ffffff"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- the list of sound or subtitle tracks: a menu over the buttons, like the desktop app's (.menu) -->
        <LinearLayout
            android:id="@+id/tracks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="40dp"
            android:layout_marginTop="80dp"
            android:layout_marginBottom="92dp"
            android:background="@drawable/player_panel_bg"
            android:elevation="12dp"
            android:minWidth="300dp"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tracksTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.05"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:textAllCaps="true"
                android:textColor="#8791a8"
                android:textSize="13sp" />

            <ScrollView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/tracksList"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

        <TextView
            android:id="@+id/playerMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="96dp"
            android:layout_marginEnd="96dp"
            android:background="#cc101318"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:padding="24dp"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- shown while the app's server starts -->
    <!-- the start screen: the logo's sun rising over a horizon across the screen (drawable/logo_rise_anim.xml), the
         name under it; "Starting…" only when it takes long (MainActivity.startSplash) -->
    <FrameLayout
        android:id="@+id/splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_background">

        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/app_name"
            android:scaleType="centerCrop"
            android:src="@drawable/logo_rise_anim" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- below the horizon (61 % of the height) and its second line (66 %) -->
            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="0.76" />

            <TextView
                android:id="@+id/splashName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0"
                android:text="@string/app_name"
                android:textColor="#eef1f8"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/splashText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="64dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="64dp"
                android:gravity="center"
                android:text="@string/starting"
                android:textColor="#9aa3b5"
                android:textSize="15sp"
                android:visibility="invisible" />

            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="0.24" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
