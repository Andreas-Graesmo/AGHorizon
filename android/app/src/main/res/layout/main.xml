<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <!-- the app: the same pages as the desktop app, from the server inside the app -->
    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- the player: covers the app while something plays -->
    <FrameLayout
        android:id="@+id/playerLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="fit"
            app:show_buffering="when_playing"
            app:show_subtitle_button="true"
            app:surface_type="surface_view"
            app:use_controller="true" />

        <LinearLayout
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/player_banner_bg"
            android:orientation="vertical"
            android:paddingStart="48dp"
            android:paddingTop="27dp"
            android:paddingEnd="48dp"
            android:paddingBottom="48dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/bannerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#ffffff"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bannerSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#d0d4dc"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/playerMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="96dp"
            android:layout_marginEnd="96dp"
            android:background="#cc101318"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:padding="24dp"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- shown while the app's server starts -->
    <LinearLayout
        android:id="@+id/splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_background"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/app_name"
            android:textColor="#eef1f8"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/splashText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="64dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="64dp"
            android:gravity="center"
            android:text="@string/starting"
            android:textColor="#9aa3b5"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
